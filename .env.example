# REQUIRED before real public launch. Use unique long random values.
ADMIN_PASSWORD=replace-with-a-strong-unique-password
SESSION_SECRET=replace-with-a-random-64-character-hex-value
# e.g. PORT=3000, or Railway injects PORT
PORT=3000
DATA_DIR=./data
# URL from your actual deployment, used in links within emails
PUBLIC_BASE_URL=http://localhost:3000

# Email: create a Resend account, verify a domain, then set these on your hosting service
RESEND_API_KEY=
EMAIL_FROM=RESTYLE <submissions@your-verified-domain.com>
ADMIN_NOTIFY_EMAIL=

# Secure cookies are automatically required for HTTPS; set to true on public Railway HTTPS
COOKIE_SECURE=false
# Enable only if behind a trusted reverse proxy that controls X-Forwarded-For
TRUST_PROXY=false
NODE_ENV=development

# Agreement: REQUIRED to activate approval + signature link; complete attorney-reviewed language before live use.
# For a TEST-ONLY nonbinding pilot, set AGREEMENT_PILOT_MODE=true and include the words DO NOT SHIP in shipping instructions.
CONSIGNMENT_AGREEMENT_TEXT=
CONSIGNMENT_SHIPPING_INSTRUCTIONS=
AGREEMENT_PILOT_MODE=false
AGREEMENT_LEGAL_APPROVED=false
